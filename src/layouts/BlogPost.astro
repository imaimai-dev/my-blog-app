---
// 型定義・各種コンポーネントをimportします。
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

// dataに加えて、OGP画像URLの組み立てに使うidも受け取る型定義にします。
type Props = CollectionEntry<'blog'>['data'] & { id: string };

const { title, description, pubDate, updatedDate, id } = Astro.props;
---

<html lang="ja">
	<head>
		<!-- ページのタイトル・メタタグ・OGP設定などをまとめて出力します。 -->
		<BaseHead title={title} description={description} />
	</head>

	<body class="bg-white dark:bg-gray-900">
		<!-- サイト共通のヘッダーです。 -->
		<Header />

		<main class="max-w-3xl mx-auto px-6 py-20">
			<article>
				<!-- 絵文字+背景色のサムネイル画像を記事上部に大きく表示します。 -->
				<img
					src={`/api/og/${id}.png`}
					alt={title}
					class="w-full aspect-[16/9] object-cover rounded-lg mb-10"
				/>

				<!-- 記事タイトルと日付をまとめたヘッダー部分です。 -->
				<div class="mb-10">
					<h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
						{title}
					</h1>
					<div class="text-sm text-gray-500 dark:text-gray-400">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="italic ml-2">
									(更新日: <FormattedDate date={updatedDate} />)
								</span>
							)
						}
					</div>
				</div>

				<!-- 記事本文です。prose(Typographyプラグイン)で見出しや段落を整形します。 -->
				<div class="prose dark:prose-invert max-w-none">
					<slot />
				</div>
			</article>
		</main>

		<!-- サイト共通のフッターです。 -->
		<Footer />
	</body>
</html>