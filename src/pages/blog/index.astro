---
// 記事データの取得に必要な関数と、各種コンポーネントをimportします。
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

// 全記事を取得し、公開日が新しい順に並び替えます。
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<!-- ページのタイトル・メタタグ・OGP設定などをまとめて出力します。 -->
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<!-- サイト共通のヘッダー(ナビゲーション・ダークモード切り替えなど)です。 -->
		<Header />
		<!-- 記事一覧の本体です。Tailwindのクラスでレイアウトを組んでいます。 -->
		<main class="max-w-4xl mx-auto px-6 py-20 bg-white dark:bg-gray-900">
			<div class="flex flex-col gap-24">
				{posts.map((post) => (
					// 各記事カード全体をリンクにしています。
		      <a href={`/blog/${post.id}`} class="group block">
					{/* 絵文字+背景色のサムネイル画像を記事idから自動生成されたURLで表示します。 */}
		        <img
		          src={`/api/og/${post.id}.png`}
		          alt={post.data.title}
		          class="w-full aspect-[16/9] object-cover rounded-lg mb-6 transition-transform duration-500 group-hover:scale-[1.02]"
		        />
						{/* 記事タイトルです。 */}
		        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">
		          {post.data.title}
		        </h2>
						{/* 記事の概要文です。 */}
		        <p class="text-gray-500 dark:text-gray-400 leading-relaxed">
		          {post.data.description}
		        </p>
		      </a>
    		))}
			</div>
		</main>
		<!-- サイト共通のフッターです。 -->
		<Footer />
	</body>
</html>
