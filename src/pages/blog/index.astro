---
// 記事データの取得に必要な関数と、各種コンポーネントをimportします。
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import BlogList from '../../components/BlogList.svelte';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

// 全記事を取得し、公開日が新しい順に並び替えます。
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

/* 
Svelteアイランドに渡すため、必要なフィールドだけを取り出した配列に変換します。	
pubDateのようなDate型はそのままだと渡せないため、ここでは含めていません。
 */
const postSummaries = posts.map((post) => ({
		id: post.id,
		title: post.data.title,
		description: post.data.description,
}));
---

<!doctype html>
<html lang="ja">
	<head>
		<!-- ページのタイトル・メタタグ・OGP設定などをまとめて出力します。 -->
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-gray-50 dark:bg-gray-950">
		<!-- サイト共通のヘッダー(ナビゲーション・ダークモード切り替えなど)です。 -->
		<Header />

		<main class="max-w-5xl mx-auto px-6 py-20">
			<h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-10">Blog</h1>
			<!-- 記事一覧本体です。表示形式の切り替えボタンごとSvelteアイランドに任せています。 -->
			<BlogList posts={postSummaries} client:load />
		</main>

		<!-- サイト共通のフッターです。 -->
		<Footer />
	</body>
</html>
