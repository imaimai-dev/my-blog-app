---
import { getCollection } from 'astro:content';
import BlogList from '../../components/BlogList.svelte';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortPosts, toPostCard } from '../../utils/posts';

const posts = sortPosts(await getCollection('blog', ({ data }) => !data.draft));
const postCards = posts.map(toPostCard);
---

<BaseLayout title="Blog" description="Web開発、クラウド、DevOpsの学習記事一覧です。">
  <section class="blog-page section-shell">
    <div class="site-container">
      <header class="page-header">
        <p class="section-kicker">All articles</p>
        <h1>Blog</h1>
        <p>Web開発とクラウド技術に関する、試行錯誤の記録を探せます。</p>
      </header>
      <BlogList posts={postCards} showControls client:load />
    </div>
  </section>
</BaseLayout>

<style>
  .blog-page { padding-top: clamp(3.8rem, 8vw, 6.8rem); }

  .page-header {
    max-width: 700px;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  h1 {
    margin: 0;
    color: var(--text);
    font-size: clamp(3.4rem, 8vw, 6.2rem);
    font-weight: 700;
    letter-spacing: -0.075em;
    line-height: 1;
  }

  .page-header > p:last-child {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 1rem;
  }
</style>
