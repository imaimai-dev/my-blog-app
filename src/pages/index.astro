---
import { getCollection } from 'astro:content';
import BlogList from '../components/BlogList.svelte';
import HeroProfile from '../components/HeroProfile.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sortPosts, toPostCard } from '../utils/posts';

const posts = sortPosts(await getCollection('blog', ({ data }) => !data.draft));
const postCards = posts.map(toPostCard);
const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].slice(0, 10);
---

<BaseLayout>
  <HeroProfile />

  <section class="tag-cloud" aria-label="記事のタグ">
    <div class="site-container tag-cloud-inner">
      {allTags.map((tag) => <a class="tag-chip" href={`/blog/?tag=${encodeURIComponent(tag)}`}>#{tag}</a>)}
    </div>
  </section>

  <section class="section-shell latest-section">
    <div class="site-container">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Latest posts</p>
          <h2 class="section-title">最近書いた記事</h2>
          <p class="section-description">技術検証のログから、実装でつまずいた箇所まで。新しい順にまとめています。</p>
        </div>
        <a class="text-link" href="/blog/">すべての記事を見る <span aria-hidden="true">→</span></a>
      </div>
      <BlogList posts={postCards} limit={6} client:visible />
    </div>
  </section>

  <section class="learning-section section-shell">
    <div class="site-container learning-grid">
      <div class="learning-copy">
        <p class="section-kicker">Now learning</p>
        <h2 class="section-title">いま深掘りしていること</h2>
        <p class="section-description">「触った」で終わらず、設計意図や運用まで説明できる状態を目指しています。</p>
      </div>
      <div class="learning-cards">
        <div class="learning-card"><span>01</span><strong>Frontend</strong><p>React / Astro / アクセシビリティ</p></div>
        <div class="learning-card"><span>02</span><strong>Cloud</strong><p>AWS / Cloudflare / IaC</p></div>
        <div class="learning-card"><span>03</span><strong>DevOps</strong><p>CI/CD / 可観測性 / SRE</p></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tag-cloud {
    border-block: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 62%, transparent);
  }

  .tag-cloud-inner {
    display: flex;
    overflow: hidden;
    gap: 0.65rem;
    padding-block: 1rem;
  }

  .latest-section { padding-top: clamp(4.5rem, 8vw, 7rem); }

  .learning-section {
    padding-top: 1rem;
  }

  .learning-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    align-items: start;
    gap: clamp(2rem, 6vw, 6rem);
    border-top: 1px solid var(--line);
    padding-top: clamp(4rem, 8vw, 7rem);
  }

  .learning-copy {
    position: sticky;
    top: 110px;
  }

  .learning-cards {
    display: grid;
    gap: 0.9rem;
  }

  .learning-card {
    display: grid;
    grid-template-columns: 58px 1fr;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--surface);
    padding: 1.15rem 1.25rem;
  }

  .learning-card span {
    grid-row: 1 / 3;
    color: var(--brand);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
  }

  .learning-card strong {
    color: var(--text);
    font-size: 1rem;
  }

  .learning-card p {
    margin: 0.1rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  @media (max-width: 760px) {
    .learning-grid { grid-template-columns: 1fr; }
    .learning-copy { position: static; }
  }
</style>
