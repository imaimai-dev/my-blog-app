---
// 記事データの取得に必要な関数と、各種コンポーネントをimportします。
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import BlogList from '../components/BlogList.svelte';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

/* 
・全記事を取得し、公開日が新しい順に並び替えます。
・トップページには直近3件だけを表示するため、sliceで絞り込みます。
・pubDateが同じ場合は、idの文字列比較で順序を確定させます(同日公開の記事が不定な順序にならないようにするため)。
*/
const posts = (await getCollection('blog'))
		.sort((a, b) => {
			const dateDiff = b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
			if (dateDiff !== 0) return dateDiff;
			return a.id.localeCompare(b.id);
		})
		.slice(0, 3);
	
// Svelteアイランドに渡すため、必要なフィールドだけを取り出した配列に変換します。
const postSummaries = posts.map((post) => ({
	id: post.id,
	title: post.data.title,
	description: post.data.description,
}));
---

<!doctype html>
<html lang="ja">
	<head>
		<!-- ページのタイトル・メタタグ・OGP設定などをまとめて出力します。 -->
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-gray-50 dark:bg-gray-950">
		<!-- サイト共通のヘッダーです。 -->
		<Header />

		<main class="max-w-4xl mx-auto px-6">
			<!-- 自己紹介セクションです。 -->
			<section class="py-10 text-center">
				<h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
					{SITE_TITLE}
				</h1>
				<p class="text-gray-500 dark:text-gray-400 leading-relaxed">
					{SITE_DESCRIPTION}
				</p>
			</section>

			<!-- 最新記事セクションです。 -->
			 <section class="pb-20">
				<h2 class="text-base font-semibold text-gray-700 dark:text-gray-200 mb-6">
					最新の記事
				</h2>
				<!-- 記事一覧ページと同じSvelteアイランドを再利用し、グリッド/リスト切り替えの挙動を統一しています。 -->
				<BlogList posts={postSummaries} client:load />
				
				<!-- 記事一覧ページへのリンクです。 -->
				<a
					href="/blog"
					class="inline-block mt-10 text-sm font-bold text-gray-900 dark:text-white hover:underline"
				>
					すべての記事を見る →
				</a>
			 </section>
		</main>

		<!-- サイト共通のフッターです。 -->
		<Footer />
	</body>
</html>
