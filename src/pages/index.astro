---
// 記事データの取得に必要な関数と、各種コンポーネントをimportします。
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// 全記事を取得し、公開日が新しい順に並び替えます。
// トップページには直近3件だけを表示するため、sliceで絞り込みます。
const posts = (await getCollection('blog'))
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
		.slice(0, 3);
---

<!doctype html>
<html lang="ja">
	<head>
		<!-- ページのタイトル・メタタグ・OGP設定などをまとめて出力します。 -->
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-gray-50 dark:bg-gray-950">
		<!-- サイト共通のヘッダーです。 -->
		<Header />

		<main class="max-w-4xl mx-auto px-6">
			<!-- 自己紹介セクションです。 -->
			<section class="py-10 text-center">
				<h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
					{SITE_TITLE}
				</h1>
				<p class="text-gray-500 dark:text-gray-400 leading-relaxed">
					{SITE_DESCRIPTION}
				</p>
			</section>

			<!-- 最新記事セクションです。 -->
			 <section class="pb-20">
				<h2 class="text-base font-semibold text-gray-700 dark:text-gray-200 mb-10">
					最新の記事
				</h2>
				<div class="flex flex-col gap-8">
					{
						posts.map((post) => (
							// 各記事カード全体をリンクにしています。
							<a
								href={`/blog/${post.id}`}
								class="group block bg-white dark:bg-gray-900 rounded-xl shadow-sm hover:shadow-md transition-shadow overflow-hidden"
							>
								{/* 絵文字+背景色のサムネイル画像を表示します。 */}
								<img
										src={`/api/og/${post.id}.png`}
										alt={post.data.title}
										class="w-full aspect-video object-cover transition-transform duration-500 group-hover:scale-[1.02]"
								/>
								{/* 記事タイトルです。 */}
								<div class="p-6">
								<h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
									{post.data.title}
								</h3>
								{/* 記事の概要文です。 */}
								<p class="text-gray-500 dark:text-gray-400 leading-relaxed text-sm">
									{post.data.description}
								</p>
								</div>
							</a>
						))
					}
				</div>
				<!-- 記事一覧ページへのリンクです。 -->
				<a
					href="/blog"
					class="inline-block mt-10 text-sm font-bold text-gray-900 dark:text-white hover:underline"
				>
					すべての記事を見る →
				</a>
			 </section>
		</main>

		<!-- サイト共通のフッターです。 -->
		<Footer />
	</body>
</html>
