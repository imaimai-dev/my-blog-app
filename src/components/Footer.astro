---
import { GITHUB_URL, SITE_TITLE } from '../consts';
---

<footer class="footer">
  <div class="site-container footer-inner">
    <div>
      <a class="footer-brand" href="/">{SITE_TITLE}</a>
      <p>学んだことを、未来の自分と誰かのために。</p>
    </div>
    <div class="footer-links">
      <a href="/blog/">Blog</a>
      <a href="/about/">About</a>
      <a href="/rss.xml">RSS</a>
      <a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub ↗</a>
    </div>
  </div>
  <div class="site-container copyright">
    <span>© {new Date().getFullYear()} imai</span>
    <span>Built with Astro & Cloudflare Workers.</span>
  </div>
</footer>

<style>
  .footer {
    margin-top: 5rem;
    border-top: 1px solid var(--line);
    padding: 3.4rem 0 6.5rem;
    background: color-mix(in srgb, var(--surface) 65%, transparent);
  }

  .footer-inner,
  .copyright {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }

  .footer-brand {
    color: var(--text);
    font-size: 1.08rem;
    font-weight: 700;
  }

  p {
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 1.2rem;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .footer-links a:hover { color: var(--brand); }

  .copyright {
    margin-top: 2.4rem;
    border-top: 1px solid var(--line);
    padding-top: 1.2rem;
    color: var(--subtle);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.68rem;
  }

  @media (max-width: 640px) {
    .footer-inner,
    .copyright {
      flex-direction: column;
    }

    .footer-links { justify-content: flex-start; }
    .footer { padding-bottom: 7rem; }
  }
</style>
