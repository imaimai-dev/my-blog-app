---
import { GITHUB_URL, SITE_TITLE } from '../consts';
import DarkModeToggle from './DarkModeToggle';

const pathname = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header">
  <div class="site-container header-inner">
    <a class="brand" href="/" aria-label={`${SITE_TITLE}のトップページ`}>
      <span class="brand-mark" aria-hidden="true">i</span>
      <span>{SITE_TITLE}</span>
    </a>

    <nav class="desktop-nav" aria-label="メインナビゲーション">
      {navItems.map((item) => (
        <a href={item.href} class:list={["nav-link", { active: isActive(item.href) }]}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="icon-link" href={GITHUB_URL} target="_blank" rel="noreferrer" aria-label="GitHubを開く">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M12 .7a11.6 11.6 0 0 0-3.67 22.6c.58.1.8-.25.8-.56v-2.24c-3.25.7-3.94-1.38-3.94-1.38-.53-1.35-1.3-1.7-1.3-1.7-1.07-.73.08-.72.08-.72 1.18.08 1.8 1.21 1.8 1.21 1.05 1.8 2.75 1.28 3.42.98.1-.76.41-1.28.75-1.57-2.6-.3-5.33-1.3-5.33-5.75 0-1.27.45-2.3 1.2-3.12-.12-.3-.52-1.48.11-3.08 0 0 .98-.31 3.2 1.2a11.1 11.1 0 0 1 5.82 0c2.22-1.51 3.2-1.2 3.2-1.2.63 1.6.23 2.78.11 3.08.75.82 1.2 1.85 1.2 3.12 0 4.46-2.74 5.45-5.34 5.74.42.36.79 1.08.79 2.18v3.24c0 .31.21.67.8.56A11.6 11.6 0 0 0 12 .7Z"/>
        </svg>
      </a>
      <DarkModeToggle client:load />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 78%, transparent);
    background: color-mix(in srgb, var(--page) 82%, transparent);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    display: grid;
    min-height: 72px;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.65rem;
    color: var(--text);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .brand-mark {
    display: grid;
    width: 31px;
    height: 31px;
    place-items: center;
    border-radius: 10px;
    background: var(--text);
    color: var(--page);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.92rem;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .nav-link {
    border-radius: 999px;
    padding: 0.46rem 0.78rem;
    color: var(--muted);
    font-size: 0.88rem;
    font-weight: 500;
    transition: color 140ms ease, background-color 140ms ease;
  }

  .nav-link:hover,
  .nav-link.active {
    background: var(--surface);
    color: var(--text);
  }

  .header-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.35rem;
  }

  .icon-link {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: 50%;
    color: var(--muted);
    transition: color 140ms ease, background-color 140ms ease;
  }

  .icon-link:hover {
    background: var(--surface);
    color: var(--text);
  }

  .icon-link svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 680px) {
    .header-inner {
      grid-template-columns: 1fr auto;
    }

    .desktop-nav {
      position: fixed;
      right: 12px;
      bottom: 14px;
      left: 12px;
      z-index: 60;
      justify-content: center;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: color-mix(in srgb, var(--surface-raised) 92%, transparent);
      box-shadow: var(--shadow);
      padding: 0.35rem;
      backdrop-filter: blur(18px);
    }

    .nav-link {
      flex: 1;
      text-align: center;
    }
  }
</style>
